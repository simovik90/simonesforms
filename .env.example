# Copia in .env e personalizza. Il file .env non va committato.
AUTH_EMAIL=simone@mscommunication.it
AUTH_PASSWORD=
AUTH_COOKIE_SECRET=cambia-questa-stringa-lunga-e-casuale
# Solo se il sito è servito in HTTPS (altrimenti il cookie non viene inviato):
# AUTH_HTTPS=1

# Opzionale: persistenza su Supabase (Vercel / produzione). Senza queste variabili si usano i file in data/.
# Crea la tabella con supabase/migrations/001_app_data.sql
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJ...   # solo server, mai nel browser o su GitHub
